# Copy to .env and fill in the secrets. .env is git-ignored; never commit it.

# PostgreSQL (docker compose builds DATABASE_URL from these)
POSTGRES_USER=olea
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olea

# Auth: generate with `openssl rand -hex 32`
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seed mock data and enable the "Get a direct access here" button
DEMO_MODE=true

# RAG pipeline (Pinecone vector database)
PINECONE_API_KEY=
PINECONE_ENV=gcp-starter

# Host ports and limits (optional)
POSTGRES_PORT=5432
GATEWAY_PORT=8080
RAG_MEMORY_LIMIT=6g
