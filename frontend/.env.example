# Local development backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# For Vercel production, set this in Vercel Project Settings -> Environment Variables,
# use your Render backend URL:
# NEXT_PUBLIC_API_BASE_URL=https://olea-insurance-3.onrender.com

# Behind the docker compose gateway or a Kubernetes Ingress (API on the same host):
# NEXT_PUBLIC_API_BASE_URL=/
